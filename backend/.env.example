DATABASE_URL="postgresql://postgres:postgres@localhost:5432/facturacion?schema=public"
PORT=4000
JWT_SECRET="change-this-secret-in-production"
JWT_EXPIRES_IN="8h"
CORS_ORIGIN="http://localhost:5173"
BCRYPT_SALT_ROUNDS=10

# SMTP opcional: si se configura, el sistema enviara correos de recuperacion de
# contrasena y envio de facturas por correo. Si se deja vacio, el sistema
# funciona igual pero solo registra el intento de envio en el log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Facturacion <no-reply@empresa.com>"

FRONTEND_URL="http://localhost:5173"

